# Base URL ของ backend (ใช้ใน src/services/*.ts เมื่อเปลี่ยนจากข้อมูลตัวอย่างเป็น API จริง)
# production: https://napaii.com/api หรือ https://api.napaii.com
VITE_API_URL=http://localhost:3000/api

# LINE Official Account ID ของบริษัท (มี @ นำหน้า) — ใช้เปิดแชทพร้อมข้อความ (ขอทริปส่วนตัว/กลุ่ม); ปุ่มเพิ่มเพื่อน/จองทัวร์ใช้ลิงก์ทางการใน src/utils/line.ts
VITE_LINE_OA_ID=@442feylf

# เบอร์ Call Center (แสดงและกดโทรได้ในแผงจองทัวร์)
VITE_CALL_CENTER=02-000-0000
